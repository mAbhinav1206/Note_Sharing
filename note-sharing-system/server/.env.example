# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Port the Express server listens on
PORT=5050

# Environment: development | production | test
NODE_ENV=development

# MongoDB connection string (local MongoDB or MongoDB Atlas)
# Local : mongodb://127.0.0.1:27017/note_sharing
# Atlas : mongodb+srv://USER:PASSWORD@cluster.mongodb.net/note_sharing
MONGO_URI=mongodb://127.0.0.1:27017/note_sharing

# Secret used to sign JWT access tokens (use a long random string)
JWT_SECRET=change_me_to_a_long_random_secret_string
JWT_EXPIRES_IN=1d

# Allowed frontend origin for CORS (Vite dev server)
CLIENT_URL=http://localhost:5173

# Set to true only when serving over HTTPS (production)
COOKIE_SECURE=false
